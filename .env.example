# Variables read by docker-compose.yml. Copy to .env and edit; every entry has
# a laptop-only default in docker-compose.yml, so an empty .env also works.
# Never commit .env.

# Postgres (the `db` service). The backend's DATABASE_URL is assembled from these.
POSTGRES_USER=kanban
POSTGRES_PASSWORD=kanban
POSTGRES_DB=kanban
POSTGRES_PORT=5433

# Backend. JWT_SECRET must be at least 32 characters; generate one with
#   uv run --directory backend python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=local-only-jwt-secret-change-me-for-anything-public
CORS_ORIGINS=http://localhost:3000
# AI card actions: set one provider key, or neither to run without the AI
# routes (they answer 503). OpenAI is preferred when both are set;
# AI_PROVIDER=openai|gemini forces one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_PROVIDER=
BACKEND_PORT=8000

# Frontend. Baked into the browser bundle at image build time, so change it
# and rebuild (`docker compose up --build`). It is the URL the *browser* uses.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
